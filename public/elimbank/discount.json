"ssc-m-04-003": {"t":["plug"],"elim":"1.6 × 0.75 = 1.2 CP; 150 kam karke 1.14 CP → 0.06 CP = 150 → 2,500. Option daalo: 2,500 × 0.06 = 150 ✓.","fast":"150 / 0.06 = 2,500.","cut":{"0":"0.06 × 2,000 = 120.","2":"0.06 × 3,000 = 180.","3":"0.06 × 3,500 = 210."}},
