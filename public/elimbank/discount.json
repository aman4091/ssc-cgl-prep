{
"ssc-m-04-001": {"t":["value","trap"],"elim":"P = 120 maan lo → CP 100. MP 180, 10% off → 162 → 62%. Options fraction mein (0.62 = 62%).","fast":"1.5 × 0.9 × 1.2 = 1.62.","cut":{"0":"Galat.","1":"Galat.","3":"Trap: discount bhool kar 1.5 × … nahi, 0.6 bhi galat."}},
