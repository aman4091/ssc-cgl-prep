"ssc-m-04-005": {"t":["value","bound"],"elim":"Y = 90 → CP 100. MP 72, 5% off → 68.4 → loss 31.6%. 2.5% bahut kam, 57.5/66.67 bahut zyada (SP to 68 hai).","fast":"0.8 × 0.95 × 0.9 = 0.684.","cut":{"0":"Bound: SP 68 par loss 2.5% nahi.","1":"Bahut zyada.","2":"Bahut zyada."}},
