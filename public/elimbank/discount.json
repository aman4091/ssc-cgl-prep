"ssc-m-04-008": {"t":["range"],"elim":"Chain 1.6 × 0.85 × 1.25 × 0.9 = 1.53 → 14,490/1.53 ≈ 9,471. 9,500 × 1.53 = 14,535 (zyada) — exact chahiye, approx wala trap.","fast":"14,490 / 1.53 = 9,470.6.","cut":{"1":"9,500 × 1.53 = 14,535 — 45 zyada.","2":"10,000 × 1.53 = 15,300.","3":"Zyada."}},
