{
"ssc-m-03-001": {"t":["unit"],"elim":"Ek din: 3 × 500 × 2% = 30, 4 × 150 × 12% = 72 → 102. × 30 → aakhri do ank …60. Sirf 3,060 …60 par.","fast":"102 × 30 = 3,060.","cut":{"0":"…50 par khatam — 102 × 30 aisa nahi deta.","1":"100 × 30 — 2 rupaye roz chhoot gaye.","3":"…00 — galat."}},
"ssc-m-03-002": {"t":["value"],"elim":"Dishonest weight: (SP ratio) / (diya hua wazan) = 0.95 / 0.8 = 1.1875 → 18.75%.","fast":"95/80 = 19/16 → 3/16 = 18.75%.","cut":{"0":"Galat.","1":"Galat.","2":"Galat."}},
"ssc-m-03-003": {"t":["bound"],"elim":"Profit = loss → CP beech mein = (2,200 + 1,800)/2 = 2,000. 2,050 > 2,000 → PROFIT → dono 'loss' wale kaato. 50/2,000 = 2.5%.","fast":"50/2000 = 2.5%.","cut":{"0":"Profit sahi, par 50/2000 = 2.5, 2.25 nahi.","1":"Loss ho hi nahi sakta — 2,050 CP se zyada.","3":"Loss ho hi nahi sakta."}},
"ssc-m-03-004": {"t":["div","plug"],"elim":"CP ek ka = 3,000 / 1.25 / 15 = 160; naya SP = 176. 2,816 ÷ 176 = 16 (176 × 16 = 2,816 — unit 6 × 6 = 36 → 6 ✓).","fast":"2816/176 = 16.","cut":{"0":"176 × 15 = 2,640.","2":"176 × 17 = 2,992.","3":"176 × 18 = 3,168."}},
"ssc-m-03-005": {"t":["bound","value"],"elim":"Kis taraf? B par 50% profit bahut bada, A par sirf 10% loss → overall PROFIT. Loss wale (a, d) kaato. CP: 4/0.9 + 5/1.5 + 6 ≈ 4.44 + 3.33 + 6 = 13.78; SP 15 → 8.87%.","fast":"15/13.78 ≈ 1.089.","cut":{"0":"Loss nahi — B ka 50% profit bhari.","2":"Profit hai par 10.88 bahut zyada.","3":"Loss nahi."}},
"ssc-m-03-006": {"t":["direct"],"elim":"5% = 125 → CP = 2,500.","fast":"125 × 20.","cut":{"0":"2,100 ka 5% = 105.","1":"2,000 ka 5% = 100.","3":"1,500 ka 5% = 75."}},
"ssc-m-03-007": {"t":["bound","value"],"elim":"20% aur 30% profit, sirf 10% loss → PROFIT. CP: 5/1.2 + 6/0.9 + 7/1.3 ≈ 4.17 + 6.67 + 5.38 = 16.22; SP 18 → ≈ 11%.","fast":"18/16.22 ≈ 1.11.","cut":{"0":"Profit sahi par 12.25 zyada.","1":"Loss nahi.","3":"Loss nahi."}},
"ssc-m-03-008": {"t":["direct"],"elim":"10 ki bikri par 4 ka CP gaya → loss % = 4/10 = 40%.","fast":"4/10.","cut":{"1":"Galat.","2":"Trap: 6/10 (SP wala hissa).","3":"Galat."}},
"ssc-m-03-009": {"t":["range"],"elim":"Chahiye 800 × 1.3 = 1,040; bikne layak 180 → 1,040/180 ≈ 5.8. Andaaza: 180 × 6 = 1,080 → thoda kam → 5.78.","fast":"1040/180 = 5.78.","cut":{"0":"Bahut zyada (≈ 1,413).","1":"Zyada (≈ 1,177).","3":"Kam — CP (4) se bhi neeche."}},
"ssc-m-03-010": {"t":["trap"],"elim":"P : C = 2 : 7 → SP = 9 → SP : P = 9 : 2.","fast":"(2 + 7) : 2.","cut":{"1":"Galat.","2":"Galat.","3":"Galat."}},
"ssc-m-03-011": {"t":["value"],"elim":"MP = 100: 10 box = 800 → CP 80; SP = 98 → 18/80 = 22.5%.","fast":"98/80 = 1.225.","cut":{"0":"Discount bhool gaye: 100/80 = 25% bhi nahi, 20 galat.","1":"Galat.","3":"Galat."}},
"ssc-m-03-012": {"t":["bound","value"],"elim":"Sabse bada item (5) par 20% LOSS → shak loss ka. CP: 3/1.25 + 4/1.1 + 5/0.8 = 2.4 + 3.64 + 6.25 = 12.29; SP 12 → loss 2.33%.","fast":"0.29/12.29 ≈ 2.33%.","cut":{"0":"Profit nahi — loss wala item sabse bhari.","2":"Loss sahi par 4.62 zyada.","3":"Profit nahi."}},
"ssc-m-03-013": {"t":["bound"],"elim":"Mix ka CP = (2,000 + 1,100)/70 ≈ 44.3 < 48 → PROFIT. Teen loss wale kaato.","fast":"3,360 − 3,100 = 260.","cut":{"0":"Loss nahi — 48 > 44.3.","1":"Loss nahi.","3":"Loss nahi."}},
"ssc-m-03-014": {"t":["bound"],"elim":"Loss → SP < CP → SP : CP < 1. CP 10 → SP 9 → 9 : 10.","fast":"10 − 1 = 9.","cut":{"1":"5 : 15 = 1 : 3 — 66% loss.","2":"Galat.","3":"30% loss."}},
"ssc-m-03-015": {"t":["bound"],"elim":"Mix CP = (3 × 80 + 100)/4 = 85 < 91.8 → GAIN. Loss wale kaato. 6.8/85 = 8%.","fast":"91.8/85 = 1.08.","cut":{"0":"Loss nahi.","1":"Gain sahi par 10% = 93.5.","3":"Loss nahi."}},
"ssc-m-03-016": {"t":["direct"],"elim":"15 bech kar 5 ka CP kamaya → 5/15 = 33.33%.","fast":"5/15.","cut":{"0":"Galat.","2":"Galat.","3":"Galat."}},
"ssc-m-03-017": {"t":["value"],"elim":"MP 7 shirt = 700 → CP 600 (6 ka) → ek 85.71; SP 96 → 96 × 7/6 = 112 → 12%.","fast":"0.96 × 7/6 = 1.12.","cut":{"0":"Galat.","1":"Galat.","3":"Galat."}},
"ssc-m-03-018": {"t":["value"],"elim":"CP = 4/5 MP = 80; SP = 95 → 15/80 = 18.75%. 25% trap (discount bhool gaye).","fast":"95/80 = 1.1875.","cut":{"0":"Galat.","2":"Galat.","3":"Trap: discount ke bina 100/80."}},
"ssc-m-03-019": {"t":["bound"],"elim":"Mix CP = (80 + 180)/5 = 52 < 57.2 → GAIN. 5.2/52 = 10%.","fast":"57.2/52 = 1.1.","cut":{"0":"Loss nahi.","2":"Gain par 8% = 56.16.","3":"Loss nahi."}},
"ssc-m-03-020": {"t":["bound"],"elim":"Mix CP = (2,000 + 3,600)/100 = 56 < 70 → PROFIT, 14 × 20 = 280.","fast":"(70 − 56) × 20 = 280.","cut":{"0":"Profit par 160 galat.","1":"Loss nahi.","2":"Loss nahi."}},
"ssc-m-03-021": {"t":["bound"],"elim":"Kul CP = 58,000 < 63,000 → PROFIT. 5,000/58,000 ≈ 8.6%.","fast":"5/58 ≈ 8.62%.","cut":{"1":"Loss nahi.","2":"Loss nahi.","3":"Trap: 5,000/63,000 (SP par)… ≈ 7.9, aur 7.26 bhi galat."}},
"ssc-m-03-022": {"t":["plug"],"elim":"0.1x − 0.05(5,000 − x) = 100 → 0.15x = 350 → 2,333.33. Option daalo: 233.33 − 133.33 = 100 ✓.","fast":"350/0.15 = 2,333.33.","cut":{"1":"333.33 − 83.33 = 250 ✗.","2":"Galat.","3":"Galat."}},
"ssc-m-03-023": {"t":["direct"],"elim":"Bikri 5,100 − 4,500 = 600 profit.","fast":"5,100 − 4,500.","cut":{"0":"Galat.","1":"Galat.","3":"Loss nahi."}},
"ssc-m-03-024": {"t":["direct"],"elim":"Investment 60,000; 120 se 84,000 → bhaav 700. 135 × 700 = 94,500 → 34,500/60,000 = 57.5%.","fast":"(94.5 − 60)/60 = 0.575.","cut":{"0":"Galat.","1":"Galat.","2":"Galat."}},
"ssc-m-03-025": {"t":["value"],"elim":"SP 120, CP 100 → SP 150, profit 30% → CP 150/1.3 = 115.38 → 15.38%.","fast":"1.25 × 1.2 / 1.3 = 1.1538.","cut":{"0":"Galat.","1":"Galat.","2":"Galat."}},
"ssc-m-03-026": {"t":["direct"],"elim":"60 × 12 + 40 × 9 = 720 + 360 = 1,080 vs 1,000 → 8% profit.","fast":"0.6 × 20 − 0.4 × 10 = 8.","cut":{"0":"Galat.","1":"Loss nahi.","2":"Loss nahi."}},
"ssc-m-03-027": {"t":["bound"],"elim":"Same SP, same % gain/loss → hamesha LOSS → gain wale kaato. CP: 400 + 666.67 = 1,066.67 → loss 66.67.","fast":"Loss% = 25²/100 = 6.25% of CP → 66.67.","cut":{"0":"Loss sahi par 31.25 (6.25% of 500) galat base.","1":"Gain nahi ho sakta.","2":"Gain nahi ho sakta."}},
"ssc-m-03-028": {"t":["direct"],"elim":"SP/CP = 90/80 → 12.5%. 10% trap (seedha 90 − 80).","fast":"10/80.","cut":{"0":"Trap: 90 − 80 ko % maana.","2":"Galat.","3":"Galat."}},
"ssc-m-03-029": {"t":["direct"],"elim":"3,900 − 4,000 = 100 loss.","fast":"3,900 − 4,000.","cut":{"1":"Galat.","2":"Profit nahi.","3":"Profit nahi."}}
}
